<!DOCTYPE html>
<html lang="ro" style="background:#16141A!important" data-color-scheme="dark">
<head>
<meta charset="UTF-8">
<meta name="color-scheme" content="dark">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="color-scheme" content="dark">
<title>Bostisthetics — Descoperă-ți planul</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg: #16141A;
  --card: #1e1c24;
  --amber: #F59B00;
  --amber-glow: rgba(245,155,0,0.15);
  --amber-border: rgba(245,155,0,0.25);
  --text: #f4f0ff;
  --muted: #7b7891;
  --border: rgba(255,255,255,0.07);
  --red: #ff4757;
  --green: #2ed573;
}

html, body {
  min-height: 100%;
  background: #16141A !important;
  color: #f4f0ff !important;
  font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  overflow-x: hidden;
}

/* BG texture */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(245,155,0,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 60% 40% at 80% 100%, rgba(245,155,0,0.04) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

/* ── HEADER ── */
.header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  background: rgba(22,20,26,0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.logo {
  display: flex; align-items: center; gap: 8px;
}
.logo-b {
  width: 30px; height: 30px;
  background: #F59B00;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 17px; color: #16141A;
  box-shadow: 0 0 12px rgba(245,155,0,0.4);
}
.logo-text {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 17px; letter-spacing: 1.5px;
}
.logo-text span { color: #F59B00; }

/* progress bar */
.progress-wrap {
  display: flex; align-items: center; gap: 10px;
}
.progress-track {
  width: 80px; height: 4px;
  background: rgba(255,255,255,0.08);
  border-radius: 4px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #F59B00;
  border-radius: 4px;
  transition: width 0.4s ease;
  box-shadow: 0 0 8px #F59B00;
}
.progress-label {
  font-size: 11px; color: #7b7891;
  letter-spacing: 1px; white-space: nowrap;
}

/* ── MAIN ── */
main {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 90px 20px 40px;
}

/* ── INTRO SCREEN ── */
.intro {
  text-align: center;
  max-width: 380px;
  animation: fadeUp 0.6s ease forwards;
}
.intro-badge {
  display: inline-block;
  font-size: 10px; letter-spacing: 2.5px;
  text-transform: uppercase;
  color: #F59B00;
  border: 1px solid var(--amber-border);
  border-radius: 20px;
  padding: 5px 14px;
  margin-bottom: 24px;
}
.intro h1 {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 42px; line-height: 1.05;
  letter-spacing: 0.5px;
  margin-bottom: 16px;
}
.intro h1 span { color: #F59B00; }
.intro p {
  font-size: 15px; line-height: 1.7;
  color: #a09cba; font-weight: 300;
  margin-bottom: 32px;
}
.intro-features {
  display: flex; flex-direction: column; gap: 10px;
  margin-bottom: 36px; text-align: left;
}
.feat {
  display: flex; align-items: center; gap: 10px;
  font-size: 14px; color: #c0bcd8;
}
.feat-dot {
  width: 24px; height: 24px; flex-shrink: 0;
  background: var(--amber-glow);
  border: 1px solid var(--amber-border);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px;
}

/* ── BUTTONS ── */
.btn-primary {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  background: #F59B00 !important;
  color: #16141A !important;
  font-family: 'Bebas Neue', Impact, sans-serif;
  font-size: 16px; letter-spacing: 2px;
  padding: 15px 36px;
  border-radius: 50px;
  border: none; cursor: pointer;
  box-shadow: 0 0 28px rgba(245,155,0,0.35);
  transition: transform 0.15s, box-shadow 0.15s;
  width: 100%;
}
.btn-primary:active { transform: scale(0.96); box-shadow: 0 0 14px rgba(245,155,0,0.2); }

.btn-outline {
  display: inline-flex; align-items: center; justify-content: center;
  background: transparent;
  color: #7b7891;
  font-size: 13px;
  padding: 10px 20px;
  border-radius: 50px;
  border: 1px solid rgba(255,255,255,0.07);
  cursor: pointer;
  margin-top: 12px;
  width: 100%;
  transition: border-color 0.2s, color 0.2s;
}
.btn-outline:hover { border-color: var(--amber-border); color: #F59B00; }

/* ── QUIZ SCREEN ── */
.quiz-screen { display: none; width: 100%; max-width: 400px; }
.quiz-screen.active { display: block; animation: fadeUp 0.4s ease forwards; }

.question-num {
  font-size: 10px; letter-spacing: 2.5px;
  text-transform: uppercase; color: #F59B00;
  margin-bottom: 10px;
}
.question-text {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 28px; line-height: 1.15;
  margin-bottom: 8px;
}
.question-sub {
  font-size: 13px; color: #7b7891;
  margin-bottom: 28px; line-height: 1.5;
}

/* OPTIONS */
.options { display: flex; flex-direction: column; gap: 10px; }
.opt {
  background: #1e1c24;
  border: 1.5px solid rgba(255,255,255,0.07);
  border-radius: 16px;
  padding: 16px 18px;
  cursor: pointer;
  display: flex; align-items: center; gap: 12px;
  transition: border-color 0.2s, background 0.2s, transform 0.15s;
  position: relative;
  overflow: hidden;
}
.opt:active { transform: scale(0.98); }
.opt.selected {
  border-color: #F59B00;
  background: var(--amber-glow);
}
.opt-icon { font-size: 20px; flex-shrink: 0; }
.opt-label { font-size: 14px; font-weight: 400; color: #f4f0ff; }
.opt-check {
  margin-left: auto;
  width: 20px; height: 20px;
  border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.07);
  flex-shrink: 0;
  transition: all 0.2s;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px;
}
.opt.selected .opt-check {
  background: #F59B00;
  border-color: #F59B00;
  color: #16141A;
}

/* NUMBER INPUT */
.num-input-wrap {
  display: flex; align-items: center; gap: 12px;
  background: #1e1c24;
  border: 1.5px solid rgba(255,255,255,0.07);
  border-radius: 16px;
  padding: 16px 18px;
  margin-bottom: 10px;
}
.num-input-wrap:focus-within { border-color: #F59B00; }
.num-input {
  background: none; border: none; outline: none;
  font-size: 28px; font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  color: #F59B00; width: 100%;
  letter-spacing: 1px;
}
.num-input::placeholder { color: rgba(245,155,0,0.3); }
.num-unit {
  font-size: 13px; color: #7b7891;
  white-space: nowrap; flex-shrink: 0;
}

/* NAV */
.quiz-nav {
  display: flex; gap: 10px; margin-top: 24px;
}

/* ── RESULT SCREEN ── */
.result-screen { display: none; width: 100%; max-width: 400px; }
.result-screen.active { display: block; animation: fadeUp 0.5s ease forwards; }

.result-header { text-align: center; margin-bottom: 28px; }
.result-badge {
  display: inline-block;
  font-size: 9px; letter-spacing: 2.5px;
  text-transform: uppercase; color: #F59B00;
  border: 1px solid var(--amber-border);
  border-radius: 20px; padding: 4px 12px;
  margin-bottom: 14px;
}
.result-name {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 32px; line-height: 1.1;
  margin-bottom: 6px;
}
.result-name span { color: #F59B00; }

/* SCORE CARD */
.score-card {
  background: linear-gradient(135deg, #1e1c24 0%, #1a1820 100%);
  border: 1px solid var(--amber-border);
  border-radius: 20px;
  padding: 24px 20px;
  margin-bottom: 16px;
  position: relative; overflow: hidden;
}
.score-card::before {
  content: '';
  position: absolute; top: -40px; right: -40px;
  width: 140px; height: 140px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(245,155,0,0.1) 0%, transparent 70%);
}
.score-label {
  font-size: 10px; letter-spacing: 2px;
  text-transform: uppercase; color: #7b7891;
  margin-bottom: 4px;
}
.score-value {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 52px; line-height: 1;
  color: #F59B00; letter-spacing: -1px;
}
.score-unit { font-size: 16px; color: #7b7891; margin-left: 4px; }
.score-desc { font-size: 13px; color: #a09cba; margin-top: 6px; line-height: 1.5; }

/* MACROS */
.macros-grid {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 10px; margin-bottom: 16px;
}
.macro-card {
  background: #1e1c24;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 16px;
  padding: 16px 12px;
  text-align: center;
}
.macro-val {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 28px; line-height: 1;
  margin-bottom: 2px;
}
.macro-val.p { color: #63b3ed; }
.macro-val.c { color: #fbd38d; }
.macro-val.g { color: #68d391; }
.macro-name { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: #7b7891; }

/* PROBLEM CARD */
.problem-card {
  background: #1e1c24;
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 16px;
}
.problem-title {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 16px; letter-spacing: 1px;
  color: #F59B00; margin-bottom: 12px;
}
.problem-item {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: 13px; color: #a09cba; line-height: 1.5;
  margin-bottom: 10px;
}
.problem-item:last-child { margin-bottom: 0; }
.p-icon { flex-shrink: 0; font-size: 15px; margin-top: 1px; }

/* DISCLAIMER */
.disclaimer {
  font-size: 11px; color: #7b7891;
  text-align: center; line-height: 1.5;
  margin-bottom: 20px; padding: 0 10px;
}

/* CTA CARD */
.cta-card {
  background: linear-gradient(135deg, #211d12 0%, #1a1710 100%);
  border: 1.5px solid rgba(245,155,0,0.35);
  border-radius: 20px;
  padding: 24px 20px;
  text-align: center;
  margin-bottom: 12px;
}
.cta-title {
  font-family: 'Bebas Neue', Impact, 'Arial Narrow', sans-serif;
  font-size: 22px; margin-bottom: 8px;
}
.cta-body {
  font-size: 13px; color: #a09cba; line-height: 1.6;
  margin-bottom: 20px;
}

/* ANIMS */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes popIn {
  0%   { transform: scale(0.8); opacity: 0; }
  70%  { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}
.pop { animation: popIn 0.4s ease forwards; }
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="logo">
    <div class="logo-b">B</div>
    <div class="logo-text"><span style="color:#f4f0ff;">Bosti</span><span style="color:#F59B00;">sthetics</span></div>
  </div>
  <div class="progress-wrap">
    <div class="progress-track">
      <div class="progress-fill" id="progressFill" style="width:0%"></div>
    </div>
    <div class="progress-label" id="progressLabel">0 / 10</div>
  </div>
</div>

<main>

  <!-- ── INTRO ── -->
  <div class="intro" id="introScreen">
    <div class="intro-badge">Analiză gratuită · 2 minute</div>
    <h1>Care e <span>problema</span> ta reală cu corpul?</h1>
    <p>Răspunde la 10 întrebări și află exact câte calorii are nevoie corpul tău — fie că vrei să slăbești, să pui masă musculară sau să te menții.</p>
    <div class="intro-features">
      <div class="feat"><div class="feat-dot">🔥</div>TDEE calculat pe corpul tău</div>
      <div class="feat"><div class="feat-dot">💪</div>Macros personalizate (P / C / G)</div>
      <div class="feat"><div class="feat-dot">🎯</div>Scor de progres + probleme identificate</div>
      <div class="feat"><div class="feat-dot">📋</div>Plan de acțiune concret</div>
    </div>
    <button class="btn-primary" onclick="startQuiz()">Începe analiza gratuită →</button>
  </div>

  <!-- ── QUIZ SCREENS ── -->

  <!-- Q1: Sex -->
  <div class="quiz-screen" id="q1">
    <div class="question-num">Întrebarea 1 din 10</div>
    <div class="question-text">Ești bărbat sau femeie?</div>
    <div class="question-sub">Formula de calcul diferă în funcție de sex.</div>
    <div class="options">
      <div class="opt" onclick="selectOpt(this,'sex','M')">
        <div class="opt-icon">♂️</div>
        <div class="opt-label">Bărbat</div>
        <div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'sex','F')">
        <div class="opt-icon">♀️</div>
        <div class="opt-label">Femeie</div>
        <div class="opt-check"></div>
      </div>
    </div>
    <div class="quiz-nav">
      <button class="btn-primary" onclick="nextQ(2)" id="btn1" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q2: Vârstă -->
  <div class="quiz-screen" id="q2">
    <div class="question-num">Întrebarea 2 din 10</div>
    <div class="question-text">Câți ani ai?</div>
    <div class="question-sub">Metabolismul se schimbă cu vârsta.</div>
    <div class="num-input-wrap">
      <input class="num-input" type="number" id="inputAge" placeholder="25" min="16" max="80" oninput="validateNum('inputAge','btn2',16,80)">
      <span class="num-unit">ani</span>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(1)">← Înapoi</button>
      <button class="btn-primary" onclick="saveAndNext('age','inputAge',3)" id="btn2" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q3: Înălțime -->
  <div class="quiz-screen" id="q3">
    <div class="question-num">Întrebarea 3 din 10</div>
    <div class="question-text">Cât ești de înalt/ă?</div>
    <div class="question-sub">Necesar pentru calculul BMR precis.</div>
    <div class="num-input-wrap">
      <input class="num-input" type="number" id="inputHeight" placeholder="175" min="140" max="220" oninput="validateNum('inputHeight','btn3',140,220)">
      <span class="num-unit">cm</span>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(2)">← Înapoi</button>
      <button class="btn-primary" onclick="saveAndNext('height','inputHeight',4)" id="btn3" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q4: Greutate -->
  <div class="quiz-screen" id="q4">
    <div class="question-num">Întrebarea 4 din 10</div>
    <div class="question-text">Cât cântărești acum?</div>
    <div class="question-sub">Greutatea actuală, nu cea dorită.</div>
    <div class="num-input-wrap">
      <input class="num-input" type="number" id="inputWeight" placeholder="75" min="40" max="200" oninput="validateNum('inputWeight','btn4',40,200)">
      <span class="num-unit">kg</span>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(3)">← Înapoi</button>
      <button class="btn-primary" onclick="saveAndNext('weight','inputWeight',5)" id="btn4" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q5: Obiectiv -->
  <div class="quiz-screen" id="q5">
    <div class="question-num">Întrebarea 5 din 10</div>
    <div class="question-text">Care e obiectivul tău principal?</div>
    <div class="question-sub">Alege cel mai important pentru tine acum.</div>
    <div class="options">
      <div class="opt" onclick="selectOpt(this,'goal','cut')">
        <div class="opt-icon">🔥</div><div class="opt-label">Slăbire — vreau să pierd grăsime</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'goal','bulk')">
        <div class="opt-icon">💪</div><div class="opt-label">Masă musculară — vreau să cresc</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'goal','recomp')">
        <div class="opt-icon">⚡</div><div class="opt-label">Recompozitie — slăbire + mușchi simultan</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'goal','health')">
        <div class="opt-icon">🌱</div><div class="opt-label">Sănătate generală — mă simt bine</div><div class="opt-check"></div>
      </div>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(4)">← Înapoi</button>
      <button class="btn-primary" onclick="nextQ(6)" id="btn5" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q6: Activitate -->
  <div class="quiz-screen" id="q6">
    <div class="question-num">Întrebarea 6 din 10</div>
    <div class="question-text">Cât de activ/ă ești în viața de zi cu zi?</div>
    <div class="question-sub">Nu la sală — zi de zi, job, mers pe jos etc.</div>
    <div class="options">
      <div class="opt" onclick="selectOpt(this,'activity',1.2)">
        <div class="opt-icon">🪑</div><div class="opt-label">Sedentar — birou, stau mult</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'activity',1.375)">
        <div class="opt-icon">🚶</div><div class="opt-label">Ușor activ — mers, câteva activități</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'activity',1.55)">
        <div class="opt-icon">🏃</div><div class="opt-label">Moderat activ — job fizic sau sport regulat</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'activity',1.725)">
        <div class="opt-icon">⚡</div><div class="opt-label">Foarte activ — muncă fizică intensă zilnic</div><div class="opt-check"></div>
      </div>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(5)">← Înapoi</button>
      <button class="btn-primary" onclick="nextQ(7)" id="btn6" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q7: Antrenamente/săptămână -->
  <div class="quiz-screen" id="q7">
    <div class="question-num">Întrebarea 7 din 10</div>
    <div class="question-text">De câte ori mergi la sală pe săptămână?</div>
    <div class="question-sub">Sau faci sport acasă — contează orice antrenament.</div>
    <div class="options">
      <div class="opt" onclick="selectOpt(this,'gym','0')">
        <div class="opt-icon">😔</div><div class="opt-label">Deloc — abia încep</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'gym','1-2')">
        <div class="opt-icon">🌱</div><div class="opt-label">1-2 ori — începător</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'gym','3-4')">
        <div class="opt-icon">💪</div><div class="opt-label">3-4 ori — intermediar</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'gym','5+')">
        <div class="opt-icon">🔥</div><div class="opt-label">5+ ori — avansat</div><div class="opt-check"></div>
      </div>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(6)">← Înapoi</button>
      <button class="btn-primary" onclick="nextQ(8)" id="btn7" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q8: Cea mai mare problemă -->
  <div class="quiz-screen" id="q8">
    <div class="question-num">Întrebarea 8 din 10</div>
    <div class="question-text">Ce te blochează cel mai mult?</div>
    <div class="question-sub">Alege problema principală — poți fi sincer/ă.</div>
    <div class="options">
      <div class="opt" onclick="selectOpt(this,'block','food')">
        <div class="opt-icon">🍕</div><div class="opt-label">Nu știu ce să mănânc sau cât</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'block','consistency')">
        <div class="opt-icon">📅</div><div class="opt-label">Știu ce să fac dar nu mă țin de plan</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'block','training')">
        <div class="opt-icon">🏋️</div><div class="opt-label">Nu știu cum să mă antrenez corect</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'block','results')">
        <div class="opt-icon">📉</div><div class="opt-label">Fac totul dar nu văd rezultate</div><div class="opt-check"></div>
      </div>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(7)">← Înapoi</button>
      <button class="btn-primary" onclick="nextQ(9)" id="btn8" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q9: Somn -->
  <div class="quiz-screen" id="q9">
    <div class="question-num">Întrebarea 9 din 10</div>
    <div class="question-text">Câte ore dormi pe noapte?</div>
    <div class="question-sub">Somnul afectează direct compoziția corporală.</div>
    <div class="options">
      <div class="opt" onclick="selectOpt(this,'sleep','low')">
        <div class="opt-icon">😴</div><div class="opt-label">Sub 6 ore — dorm puțin</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'sleep','ok')">
        <div class="opt-icon">😌</div><div class="opt-label">6-7 ore — decent</div><div class="opt-check"></div>
      </div>
      <div class="opt" onclick="selectOpt(this,'sleep','good')">
        <div class="opt-icon">😁</div><div class="opt-label">7-9 ore — bine</div><div class="opt-check"></div>
      </div>
    </div>
    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(8)">← Înapoi</button>
      <button class="btn-primary" onclick="nextQ(10)" id="btn9" disabled>Continuă →</button>
    </div>
  </div>

  <!-- Q10: Experiență cu coaching -->
  <div class="quiz-screen" id="q10">
    <div class="question-num">Ultimul pas</div>
    <div class="question-text">Analiza ta e gata. Unde o trimitem?</div>
    <div class="question-sub">Lasă-mi numele și numărul tău — îți trimit rezultatele pe WhatsApp în câteva secunde.</div>

    <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:8px;">
      <div style="background:#16141A;border:1.5px solid rgba(255,255,255,0.1);border-radius:14px;padding:15px 16px;display:flex;align-items:center;gap:10px;">
        <span style="font-size:20px;">👤</span>
        <input id="ctaName" type="text" placeholder="Numele tău" oninput="checkContact()"
          style="background:none;border:none;outline:none;color:#f4f0ff;font-size:15px;width:100%;font-family:inherit;" />
      </div>

    </div>

    <div style="font-size:11px;color:#7b7891;text-align:center;margin-bottom:20px;">
      🔒 Datele tale sunt confidențiale și folosite doar pentru rezultate.
    </div>

    <div class="quiz-nav">
      <button class="btn-outline" onclick="nextQ(9)">← Înapoi</button>
      <button class="btn-primary" onclick="sendAndReveal()" id="btn10" disabled>Vezi rezultatul →</button>
    </div>
  </div>

  <!-- ── RESULT ── -->
  <div class="result-screen" id="resultScreen">
    <div class="result-header">
      <div class="result-badge">Analiza ta personalizată</div>
      <div class="result-name">Iată ce ai <span>nevoie</span></div>
    </div>

    <!-- TDEE SPLIT -->
    <div class="score-card pop" style="margin-bottom:10px;">
      <div class="score-label">TDEE — Totalul tău zilnic de calorii</div>
      <div><span class="score-value" id="tdeeBase">—</span><span class="score-unit">kcal/zi</span></div>
      <div class="score-desc" style="margin-top:6px;font-size:12px;color:#7b7891;">Câte calorii arde corpul tău zilnic în total, incluzând activitatea fizică.</div>
    </div>

    <div class="score-card pop" style="border-color:rgba(245,155,0,0.4);">
      <div class="score-label">De atât ai nevoie ca să-ți atingi scopul</div>
      <div style="display:flex;align-items:baseline;gap:10px;">
        <span class="score-value" id="tdeeVal">—</span><span class="score-unit">kcal/zi</span>
        <span id="tdeeAdjBadge" style="font-size:12px;border-radius:20px;padding:3px 10px;font-weight:600;"></span>
      </div>
      <div class="score-desc" id="tdeeDesc"></div>
    </div>

    <!-- MACROS -->
    <div class="macros-grid">
      <div class="macro-card">
        <div class="macro-val p" id="macroP">—</div>
        <div class="macro-name">Proteină (g)</div>
      </div>
      <div class="macro-card">
        <div class="macro-val c" id="macroC">—</div>
        <div class="macro-name">Carbohidrați (g)</div>
      </div>
      <div class="macro-card">
        <div class="macro-val g" id="macroG">—</div>
        <div class="macro-name">Grăsimi (g)</div>
      </div>
    </div>

    <!-- PROBLEMS -->
    <div class="problem-card">
      <div class="problem-title">⚠️ Ce te ține pe loc</div>
      <div id="problemsList"></div>
    </div>

    <div class="disclaimer">
      Acestea sunt estimări bazate pe formula Mifflin-St Jeor. Pentru un plan complet personalizat, ai nevoie de ajustări individuale.
    </div>

    <!-- CTA -->
    <div class="cta-card">
      <div class="cta-title">Vrei planul complet?</div>
      <div class="cta-body">Lasă-mi numele și numărul tău. Te contactez eu în maxim câteva ore — discutăm, răspund la orice întrebare, și dacă e potrivit pentru tine, mergem mai departe.</div>

      <button class="btn-primary" onclick="window.open('https://wa.me/40751708744','_blank')">
        💬 Întrebări? Scrie-mi pe WhatsApp →
      </button>
      <div style="font-size:11px;color:#7b7891;margin-top:10px;text-align:center;">Fără presiune. Doar o discuție.</div>
    </div>
    <button class="btn-outline" onclick="restartQuiz()">Refă analiza</button>
  </div>

</main>

<script>
const answers = {};
let currentQ = 0;
const TOTAL = 10;

function startQuiz() {
  document.getElementById('introScreen').style.display = 'none';
  showQ(1);
}

function showQ(n) {
  document.querySelectorAll('.quiz-screen').forEach(s => s.classList.remove('active'));
  const el = document.getElementById('q' + n);
  if (el) { el.classList.add('active'); currentQ = n; updateProgress(); }
}

function nextQ(n) { showQ(n); }

function updateProgress() {
  const pct = ((currentQ - 1) / TOTAL) * 100;
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressLabel').textContent = (currentQ - 1) + ' / ' + TOTAL;
}

function selectOpt(el, key, val) {
  el.closest('.options').querySelectorAll('.opt').forEach(o => {
    o.classList.remove('selected');
    o.querySelector('.opt-check').textContent = '';
  });
  el.classList.add('selected');
  el.querySelector('.opt-check').textContent = '✓';
  answers[key] = val;
  // enable next button
  const btnId = 'btn' + currentQ;
  const btn = document.getElementById(btnId);
  if (btn) btn.disabled = false;
}

function validateNum(inputId, btnId, min, max) {
  const v = parseInt(document.getElementById(inputId).value);
  const btn = document.getElementById(btnId);
  btn.disabled = !(v >= min && v <= max);
}

function saveAndNext(key, inputId, nextScreen) {
  answers[key] = parseInt(document.getElementById(inputId).value);
  nextQ(nextScreen);
}

function calcTDEE() {
  const { sex, age, height, weight, activity, goal } = answers;
  if (!sex || !age || !height || !weight || !activity) return null;
  // Mifflin-St Jeor BMR
  let bmr;
  if (sex === 'M') {
    bmr = 10 * weight + 6.25 * height - 5 * age + 5;
  } else {
    bmr = 10 * weight + 6.25 * height - 5 * age - 161;
  }
  let tdee = Math.round(bmr * parseFloat(activity));
  // Gym bonus
  const gymBonus = { '0': 0, '1-2': 50, '3-4': 150, '5+': 250 };
  tdee += gymBonus[answers.gym] || 0;
  return tdee;
}

function getProblems() {
  const problems = [];
  const blockMap = {
    food: { icon: '🍕', text: 'Nu știi ce sau cât să mănânci — cel mai comun motiv pentru lipsă de progres. Fără structură caloric, toate eforturile la sală sunt în van.' },
    consistency: { icon: '📅', text: 'Cunoști teoria dar nu aplici. Asta e o problemă de sistem, nu de voință — ai nevoie de structură externă și accountability.' },
    training: { icon: '🏋️', text: 'Antrenamentul nestructurat duce la stagnare sau accidentare. Progresul vine din plan, nu din improvizație.' },
    results: { icon: '📉', text: 'Dacă faci dar nu vezi rezultate, ceva e greșit în calcule sau în recuperare. Cel mai probabil: calorii, somn sau volum de antrenament.' }
  };
  if (answers.block && blockMap[answers.block]) problems.push(blockMap[answers.block]);

  if (answers.sleep === 'low') problems.push({ icon: '😴', text: 'Dormi sub 6 ore — asta sabotează recuperarea musculară și crește hormonii de foame. E la fel de important ca nutriția.' });
  if (answers.gym === '0' || answers.gym === '1-2') problems.push({ icon: '📉', text: 'Frecvența de antrenament e prea mică pentru rezultate vizibile. Minim 3x/săptămână pentru progres consistent.' });
  if (answers.coaching === 'yes_bad') problems.push({ icon: '⚠️', text: 'Ai mai încercat coaching fără succes — probabil ai primit un plan generic, nu unul adaptat pe tine.' });

  return problems.slice(0, 3);
}

function showResult() {
  document.querySelectorAll('.quiz-screen').forEach(s => s.classList.remove('active'));
  document.getElementById('progressFill').style.width = '100%';
  document.getElementById('progressLabel').textContent = '10 / 10';

  const tdee = calcTDEE();
  const { goal, weight } = answers;

  // Adjust cals for goal
  const goalAdj = { cut: -300, bulk: +300, recomp: 0, health: 0 };
  const targetCals = tdee + (goalAdj[goal] || 0);

  const protein = Math.round(weight * 2.0);
  const fat = Math.round(weight * 0.8);
  const carbCals = targetCals - (protein * 4) - (fat * 9);
  const carbs = Math.round(carbCals / 4);

  const goalDesc = {
    cut: `Ești în deficit de 300 kcal față de TDEE (${tdee} kcal). Ritmul ideal de slăbire: 0.3-0.5 kg/săptămână.`,
    bulk: `Ești în surplus de 300 kcal față de TDEE (${tdee} kcal). Ritmul ideal de creștere: 0.2-0.4 kg/săptămână.`,
    recomp: `Ești la întreținere (${tdee} kcal). Recompozitia e posibilă dar lentă — necesită disciplină maximă.`,
    health: `Ești la întreținere (${tdee} kcal). Focus pe calitatea alimentelor și mișcare regulată.`
  };

  document.getElementById('tdeeBase').textContent = tdee;
  document.getElementById('tdeeVal').textContent = targetCals;
  document.getElementById('tdeeDesc').textContent = goalDesc[goal] || '';
  const adj = targetCals - tdee;
  const badge = document.getElementById('tdeeAdjBadge');
  if (adj > 0) { badge.textContent = '+' + adj + ' kcal'; badge.style.background = 'rgba(104,211,145,0.15)'; badge.style.color = '#68d391'; }
  else if (adj < 0) { badge.textContent = adj + ' kcal'; badge.style.background = 'rgba(255,107,107,0.15)'; badge.style.color = '#ff6b6b'; }
  else { badge.textContent = '= TDEE'; badge.style.background = 'rgba(245,155,0,0.15)'; badge.style.color = '#F59B00'; }
  document.getElementById('macroP').textContent = protein;
  document.getElementById('macroC').textContent = Math.max(carbs, 50);
  document.getElementById('macroG').textContent = fat;

  const problems = getProblems();
  const pList = document.getElementById('problemsList');
  pList.innerHTML = problems.map(p =>
    `<div class="problem-item"><span class="p-icon">${p.icon}</span><span>${p.text}</span></div>`
  ).join('');

  document.getElementById('resultScreen').classList.add('active');
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function checkContact() {
  const name = document.getElementById('ctaName').value.trim();
  const btn = document.getElementById('btn10');
  btn.disabled = !(name.length >= 2);
}

function sendAndReveal() {
  const name = document.getElementById('ctaName').value.trim();
  answers.contactName = name;
  showResult();
  setTimeout(() => {
    const goal = { cut: 'slăbire', bulk: 'masă musculară', recomp: 'recompozitie', health: 'sănătate generală' }[answers.goal] || 'fitness';
    const weight = answers.weight ? answers.weight + ' kg' : '';
    const tdee = document.getElementById('tdeeVal')?.textContent || '';
    const msg = 'Bună Bosty! 👋 Sunt ' + name + ' și tocmai am completat quiz-ul tău. Obiectiv: ' + goal + ', Greutate: ' + weight + ', TDEE: ' + tdee + ' kcal/zi. Aștept să discutăm!';
    window.open('https://wa.me/40751708744?text=' + encodeURIComponent(msg), '_blank');
  }, 800);
}

function sendWhatsApp() {
  const name = document.getElementById('ctaName').value.trim();
  const phone = document.getElementById('ctaPhone').value.trim();

  const goal = { cut: 'slăbire', bulk: 'masă musculară', recomp: 'recompozitie', health: 'sănătate generală' }[answers.goal] || 'fitness';
  const weight = answers.weight ? answers.weight + ' kg' : '';
  const tdee = document.getElementById('tdeeVal')?.textContent || '';

  if (!name) {
    document.getElementById('ctaName').style.borderColor = '#F59B00';
    document.getElementById('ctaName').focus();
    return;
  }

  const msg = `Bună Bosty! 👋 Sunt ${name || 'un potențial client'} și tocmai am completat quiz-ul tău.

📊 Profilul meu:
• Obiectiv: ${goal}
• Greutate: ${weight}
• TDEE estimat: ${tdee} kcal/zi
${phone ? '• Telefon: ' + phone : ''}

Vreau să aflu mai multe despre coaching-ul tău. Poți să mă contactezi?`;

  const encoded = encodeURIComponent(msg);
  window.open('https://wa.me/40751708744?text=' + encoded, '_blank');
}

function restartQuiz() {
  Object.keys(answers).forEach(k => delete answers[k]);
  document.getElementById('resultScreen').classList.remove('active');
  document.querySelectorAll('.opt').forEach(o => {
    o.classList.remove('selected');
    o.querySelector('.opt-check').textContent = '';
  });
  document.querySelectorAll('.num-input').forEach(i => i.value = '');
  document.querySelectorAll('[id^="btn"]').forEach(b => b.disabled = true);
  document.getElementById('introScreen').style.display = 'block';
  document.getElementById('progressFill').style.width = '0%';
  document.getElementById('progressLabel').textContent = '0 / 10';
  window.scrollTo({ top: 0 });
}
</script>
</body>
</html>
